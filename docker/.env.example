# Copy to live-vlm-demo/.env (gitignored). Compose interpolates these.

# Required to start a Gemini Live Session. Catalog listing still works without it.
GEMINI_API_KEY=

# Optional override of config.toml JoyAI base_url. Accepts host:port or .../v1.
# JOYAI_BASE_URL=http://host.docker.internal:8070
