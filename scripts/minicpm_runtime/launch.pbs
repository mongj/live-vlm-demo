#!/bin/bash
#PBS -j oe
# Resource selection and the bounded walltime are supplied by the app facade.
set -euo pipefail
umask 077
test -n "${PBS_JOBID:-}" || { echo 'PBS_JOBID required; submit through PBS.' >&2; exit 2; }
test -n "${MINICPM_RUNTIME_ROOT:-}" || { echo 'MINICPM_RUNTIME_ROOT must name an existing prepared runtime.' >&2; exit 2; }
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
# PBS copies this script to its spool; never resolve support files relative to it.
exec python3 -I - "$MINICPM_RUNTIME_ROOT" <<'PY'
import os
import hashlib
from pathlib import Path
import runpy
import stat
import sys

if sys.version_info < (3, 10):
    raise SystemExit("Python 3.10+ is required for the runtime bootstrap")
root = Path(sys.argv[1])
runtime = root / "runtime"
hashes = {
    "gateway_private.py": "69da17f287a50f5fed3d1b766015380b62a4b333247e760b7700d51c8208e18e",
    "prepare.py": "bc9086e5ed52101766fc26aac78603059f2e9196ce9db72e7f7edbafa5a10978",
    "run.py": "9fda5094873030e4344bd15cdbfeebc79bd75c1f9cc84d239d3d52b8c71d0b74",
    "runtime.patch": "d73daa6be7a1da0a648811cdc727b8da0a30d691874d1bebc6c37a5c3f5affd8",
    "safety.py": "b0301d470b5570c97e7c9340fbf3d53e5be4e903308650039a6a50e3ecddaee0",
    "supervisor.py": "9d59b77548d14154519c4ebaa2f6a5e422699eb92f9fe27014224cfc1757be8e",
    "speech_broker.py": "e3fd5469e44afcbe9b78f29d0e4e62e8765bf3ab6e9f0dc48df23cf324afc95f",
    "speech_engines.py": "16b6da31266142dc2401e69a0c2a61be879bed002756d4118a52e21248b220ff",
    "speech_routes.py": "9cca039bd592c4fbca2cdbca3bfb3c61a2c1f6589fb7f7d94cc73afbfbcfc049",
    "speech_worker.py": "4b171111ae4506793e9255617a24dac68158343e660179ce26ff772536ee6f66",
    "speech-assets.json": "3e681b30e7d4d85b5e79296fd3e28dcaae092e784cd42ec6894659135c383fe0",
    "speech-requirements.in": "99cea7ba11db57602e0b45389c3179089e3823a8c8187220881d7284b10a2818",
    "speech-requirements.lock": "a983f92ea61c5b1819b75ab7ff89afea9c38833f1102940c5a73de0117240e67"
}
# Check ownership before importing ANY code from the caller-supplied root.
for path in (root, runtime, *runtime.glob("*.py")):
    info = path.lstat()
    valid_kind = stat.S_ISDIR(info.st_mode) if path in (root, runtime) else stat.S_ISREG(info.st_mode)
    if not path.is_absolute() or path.resolve() != path or not valid_kind or info.st_uid != os.geteuid() or info.st_mode & 0o077:
        raise SystemExit("Runtime bootstrap requires private owned nonsymlink paths")
for name, expected in hashes.items():
    path = runtime / name
    info = path.lstat()
    if path.resolve() != path or not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077:
        raise SystemExit("Runtime support file is not private, owned and regular")
    if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
        raise SystemExit("Runtime support code differs from the reviewed launcher")
sys.path.insert(0, str(runtime))
sys.argv = [str(runtime / "run.py"), "--root", str(root)]
runpy.run_path(sys.argv[0], run_name="__main__")
PY
