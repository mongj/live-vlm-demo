#!/bin/bash
#PBS -N joyai_cuda_check
#PBS -l select=1:ncpus=2:mem=8gb:ngpus=1:host=cvml10
#PBS -l walltime=00:05:00
#PBS -j oe
#PBS -o /dev/null
set -euo pipefail
export JOYAI_ENV=/home/mingjun/.conda/envs/joyai-py312-cu129
export PATH="$JOYAI_ENV/bin:$PATH"
export CONDA_PREFIX="$JOYAI_ENV"
export CONDA_DEFAULT_ENV="$JOYAI_ENV"
exec > /home/mingjun/live-vlm-demo/joyai/logs/verify-cu129.log 2>&1
hostname
date --iso-8601=seconds
nvidia-smi
python - <<'PY'
import importlib
import torch
import vllm
print("torch:", torch.__version__, "CUDA:", torch.version.cuda, "vLLM:", vllm.__version__, flush=True)
assert torch.version.cuda == "12.9", torch.version.cuda
assert torch.cuda.is_available(), "CUDA unavailable"
print("GPU:", torch.cuda.get_device_name(0), flush=True)
x = torch.ones((256, 256), device="cuda", dtype=torch.bfloat16)
y = x @ x
torch.cuda.synchronize()
assert y[0, 0].item() == 256
for name in ("vllm._C", "flashinfer", "aiohttp", "aiortc", "av", "cv2", "openai", "joy_interaction_webui.server"):
    importlib.import_module(name)
    print("Import OK:", name, flush=True)
print("CUDA_CHECK_PASSED", flush=True)
PY
